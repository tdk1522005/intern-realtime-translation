# Keep this key on the backend. Never place it in web/app client code.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Text translation models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Live speech translation model. Defaults to the current project model if unset.
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview

# Comma-separated browser origins allowed to call REST APIs.
# Replace/add the web team's actual development and deployed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Live audio endpointing and stop-drain settings
LIVE_VAD_RMS_THRESHOLD=450
LIVE_VAD_MIN_SPEECH_MS=200
LIVE_VAD_SILENCE_MS=600
LIVE_SEGMENT_SETTLE_MS=2500
LIVE_STOP_DRAIN_TIMEOUT_MS=20000
LIVE_STOP_QUIET_MS=2500
LIVE_STOP_TRANSLATION_REPAIR_TIMEOUT_MS=15000
LIVE_AUDIO_QUEUE_DRAIN_TIMEOUT_MS=20000
