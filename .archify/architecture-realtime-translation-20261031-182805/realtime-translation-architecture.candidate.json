  "cards": [
    {
      "dot": "cyan",
      "title": "Đường đi audio",
      "items": [
        "Browser đổi audio thành PCM16 mono 16 kHz rồi gửi liên tục qua WebSocket.",
        "Backend dùng queue hữu hạn và cờ ActivityStart/ActivityEnd để giữ thứ tự và đánh dấu lượt nói.",
        "VAD tính năng lượng RMS để nhận biết khoảng lặng; nó điều khiển ranh giới, không loại bỏ frame audio."
      ]
    },
    {
      "dot": "emerald",
      "title": "Giữ transcript và dừng an toàn",
      "items": [
        "TranscriptAssembler tách preview tạm khỏi text chuẩn, thay snapshot tích lũy mới hơn và bỏ snapshot cũ.",
        "Khi Stop, backend xả hết frame trong FIFO rồi chờ transcript yên hoặc hết thời hạn.",
        "Nếu source đã đủ nhưng bản dịch stream bị cụt, backend thử dịch lại toàn source; segment không đủ điều kiện được giữ ở failed."
      ]
    },
    {
      "dot": "violet",
      "title": "API sau phiên",
      "items": [
        "REST kiểm tra điều kiện trước khi finish session/presentation và xuất transcript EN/VN có thứ tự.",
        "summary-input là dữ liệu bàn giao cho thành viên tích hợp T5; sơ đồ này không nói rằng T5 đã được chạy trong backend."
      ]
    },
    {
      "dot": "amber",
      "title": "Đo hiệu năng và phạm vi nguồn",
      "items": [
        "Backend lưu mẫu audio→source, audio→translation và Stop→persist; báo cáo dùng nearest-rank p50/p95.",
        "Nguồn được đối chiếu theo snapshot Git cục bộ của các file liên quan; snapshot không được đẩy lên GitHub và không thay đổi nhánh chính."
      ]
    }
  ]
