  "cards": [
    {
      "dot": "emerald",
      "title": "Vì sao partial không thành segment ngay",
      "items": [
        "Partial có thể bị model sửa; assembler giữ preview riêng và chỉ final hóa sau điều kiện boundary/settle.",
        "VAD ở đây là endpointing theo RMS, không phải bộ phân loại ngữ âm; nó gửi mốc hoạt động chứ không cắt mất audio."
      ]
    },
    {
      "dot": "amber",
      "title": "Stop giữ phần cuối",
      "items": [
        "Browser flush buffer; backend giữ FIFO tail, gửi ActivityEnd, rồi mới đợi provider.",
        "Quiet window giảm chờ khi provider im lặng; hard timeout ngăn giao diện đợi vô hạn.",
        "Nếu translation cuối thiếu, backend thử repair từ full source trước khi ghi segment."
      ]
    },
    {
      "dot": "violet",
      "title": "Giới hạn của sơ đồ",
      "items": [
        "Đây là luồng một kết nối live; session resumption/khôi phục context model khi reconnect chưa được bật.",
        "Số liệu p50/p95 được ghi từ sample; diagram không khẳng định đó là benchmark đủ lớn."
      ]
    }
  ]
