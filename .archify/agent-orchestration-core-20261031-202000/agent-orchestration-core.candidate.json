  "cards": [
    {
      "dot": "cyan",
      "title": "Việc mỗi agent làm",
      "items": [
        "VAD theo dõi khoảng im lặng; TranscriptAgent gom partial/final mà không nối lặp.",
        "MemoryAgent cấp khóa segment bền vững, lưu thứ tự và trạng thái trong SQLite.",
        "GeminiTranslationAgent mở Live stream; MetricsAgent đo và lưu latency.",
        "Agent điều phối ghép các worker cho từng session; worker cục bộ không gọi thêm model."
      ]
    },
    {
      "dot": "emerald",
      "title": "Reconnect và chống trùng",
      "items": [
        "Cùng session/model/chiều dịch sẽ thử handle Gemini đã lưu; event báo resumed, fresh hoặc resume_fallback.",
        "Khóa segment đang chờ được giữ qua reconnect; ghi lặp cùng ID và nội dung không tạo segment thứ hai.",
        "Client chỉ gửi audio mới sau reconnect; binary frame chưa có ID để nhận diện audio replay."
      ]
    },
    {
      "dot": "amber",
      "title": "Giới hạn cần nhớ khi bàn giao",
      "items": [
        "Transcript cũ vẫn nằm trong database; chưa thể nạp text history vào model Live Translate vốn nhận audio.",
        "Gemini có thể từ chối handle; khi đó backend mở stream mới và báo fallback, không giả vờ đã khôi phục.",
        "Khóa chống hai stream là theo một process; triển khai nhiều worker cần khóa dùng chung."
      ]
    },
    {
      "dot": "violet",
      "title": "Đo và xuất dữ liệu",
      "items": [
        "Metrics giữ p50/p95 audio-to-source, audio-to-translation, Stop-to-final và provider connect theo từng chế độ.",
        "API core chỉ xuất transcript hai ngôn ngữ có thứ tự cho T5; không chạy T5 hoặc xây giao diện nhóm."
      ]
    }
  ]
